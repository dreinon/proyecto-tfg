{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:score-super-resolution:schema:v2:reconciliation-report",
  "title": "Closed-world Phase 2 reconciliation report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "reconciliation_id", "experiment_id", "experiment_sha256", "degradation_control_sha256", "evaluation_control_sha256", "fixture_manifest_sha256", "core_membership_id", "core_sha256", "expected_tuple_count", "terminal_tuple_count", "counts", "attempt_count", "integrity_incident_count", "tuple_state_sha256", "scientific_records_sha256", "report_sha256"],
  "properties": {
    "schema_version": {"const": 2},
    "record_type": {"const": "reconciliation-report"},
    "reconciliation_id": {"type": "string", "pattern": "^reconciliation-[0-9a-f]{64}$"},
    "experiment_id": {"type": "string", "pattern": "^experiment-[0-9a-f]{64}$"},
    "experiment_sha256": {"$ref": "#/$defs/sha256"},
    "degradation_control_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_control_sha256": {"$ref": "#/$defs/sha256"},
    "fixture_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "core_membership_id": {"type": "string", "pattern": "^core-[0-9a-f]{64}$"},
    "core_sha256": {"$ref": "#/$defs/sha256"},
    "expected_tuple_count": {"type": "integer", "minimum": 1},
    "terminal_tuple_count": {"type": "integer", "minimum": 1},
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["succeeded", "failed", "excluded"],
      "properties": {
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0}
      }
    },
    "attempt_count": {"type": "integer", "minimum": 0},
    "integrity_incident_count": {"type": "integer", "minimum": 0},
    "tuple_state_sha256": {"$ref": "#/$defs/sha256"},
    "scientific_records_sha256": {"$ref": "#/$defs/sha256"},
    "report_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
