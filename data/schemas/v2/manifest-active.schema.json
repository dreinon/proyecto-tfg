{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:score-super-resolution:schema:v2:manifest-active",
  "title": "Active compact SMB manifest generation pointer v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "manifest_id",
    "generation_id",
    "descriptor_path",
    "records_path",
    "row_schema_id",
    "row_schema_version",
    "row_count",
    "records_sha256"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "record_type": {"const": "manifest-active"},
    "manifest_id": {"const": "smb-evaluation-v2"},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "descriptor_path": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}/manifest-descriptor\\.yaml$"
    },
    "records_path": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}/manifest-records\\.jsonl$"
    },
    "row_schema_id": {"const": "manifest-row"},
    "row_schema_version": {"const": 2},
    "row_count": {"const": 685},
    "records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_descriptor_path": {
      "type": "string",
      "pattern": "^data/manifests/recovery/canonical-pixel-v2/[0-9a-f]{64}/manifest-recovery\\.yaml$"
    },
    "recovery_descriptor_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "recovery_records_path": {
      "type": "string",
      "pattern": "^data/manifests/recovery/canonical-pixel-v2/[0-9a-f]{64}/manifest-records\\.jsonl\\.gz$"
    },
    "recovery_records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "oneOf": [
    {
      "not": {
        "anyOf": [
          {"required": ["recovery_descriptor_path"]},
          {"required": ["recovery_descriptor_sha256"]},
          {"required": ["recovery_records_path"]},
          {"required": ["recovery_records_sha256"]}
        ]
      }
    },
    {
      "required": [
        "recovery_descriptor_path",
        "recovery_descriptor_sha256",
        "recovery_records_path",
        "recovery_records_sha256"
      ]
    }
  ]
}
