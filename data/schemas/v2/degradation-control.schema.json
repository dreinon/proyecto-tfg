{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:score-super-resolution:schema:v2:degradation-control",
  "title": "Controlled score degradation registry and frozen control v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type"],
  "properties": {
    "schema_version": {"const": 2},
    "record_type": {"const": "degradation-control"},
    "registry_id": {"const": "controlled-score-candidates"},
    "registry_policy": {"const": "append-only-monotonic-explicit"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "control_id": {"const": "controlled-score-v1"},
    "version": {"const": 1},
    "status": {"const": "frozen"},
    "candidate_id": {"const": "controlled-score-v4-candidate"},
    "candidate_version": {"const": 4},
    "claim_boundary": {"const": "controlled-synthetic-only"},
    "master_seed": {"type": "integer", "minimum": 0},
    "candidate_sha256": {"$ref": "#/$defs/sha256"},
    "decision_sha256": {"$ref": "#/$defs/sha256"},
    "decision_reconciliation_sha256": {"$ref": "#/$defs/sha256"},
    "previous_candidate_sha256": {"$ref": "#/$defs/sha256"},
    "previous_candidate_decision_sha256": {"$ref": "#/$defs/sha256"},
    "notebook_source_sha256": {"$ref": "#/$defs/sha256"},
    "working_notebook_logical_sha256": {"$ref": "#/$defs/sha256"},
    "preview_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "membership_sha256": {"$ref": "#/$defs/sha256"},
    "mapping_sha256": {"$ref": "#/$defs/sha256"},
    "panel_sha256s": {
      "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "legacy_evidence_reconciliation_sha256": {"$ref": "#/$defs/sha256"},
    "previous_candidate_evidence_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "prior_candidate_evidence_inventory_sha256s": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlled-score-v1-candidate", "controlled-score-v2-candidate", "controlled-score-v3-candidate"],
      "properties": {
        "controlled-score-v1-candidate": {"$ref": "#/$defs/sha256"},
        "controlled-score-v2-candidate": {"$ref": "#/$defs/sha256"},
        "controlled-score-v3-candidate": {"$ref": "#/$defs/sha256"}
      }
    },
    "scientific_decision_record_id": {"const": "DEC-SCI-01"},
    "scientific_decision_record_sha256": {"$ref": "#/$defs/sha256"},
    "image_contract": {"$ref": "#/$defs/candidate/properties/image_contract"},
    "alignment": {"$ref": "#/$defs/candidate/properties/alignment"},
    "runtime": {"$ref": "#/$defs/candidate/properties/runtime"},
    "condition_order": {"$ref": "#/$defs/candidate/properties/condition_order"},
    "conditions": {"$ref": "#/$defs/candidate/properties/conditions"}
  },
  "oneOf": [
    {
      "required": ["registry_id", "registry_policy", "candidates"]
    },
    {
      "required": [
        "control_id", "version", "status",
        "candidate_id", "candidate_version", "claim_boundary", "master_seed",
        "candidate_sha256", "decision_sha256", "decision_reconciliation_sha256",
        "previous_candidate_sha256", "previous_candidate_decision_sha256",
        "notebook_source_sha256",
        "working_notebook_logical_sha256", "preview_manifest_sha256",
        "membership_sha256", "mapping_sha256", "panel_sha256s",
        "legacy_evidence_reconciliation_sha256",
        "previous_candidate_evidence_inventory_sha256",
        "prior_candidate_evidence_inventory_sha256s",
        "scientific_decision_record_id", "scientific_decision_record_sha256",
        "image_contract", "alignment", "runtime", "condition_order", "conditions"
      ]
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "candidate_id", "status", "claim_boundary", "master_seed",
        "image_contract", "alignment", "runtime", "condition_order", "conditions"
      ],
      "properties": {
        "version": {"type": "integer", "minimum": 1, "maximum": 32},
        "candidate_id": {"type": "string", "pattern": "^controlled-score-v[1-9][0-9]*-candidate$"},
        "status": {"const": "candidate"},
        "claim_boundary": {"const": "controlled-synthetic-only"},
        "master_seed": {"type": "integer", "minimum": 0},
        "previous_candidate_sha256": {"$ref": "#/$defs/sha256"},
        "image_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode", "dtype", "range", "channel_degradation",
            "restoration_preprocessing", "forbidden_transformations"
          ],
          "properties": {
            "mode": {"const": "RGB"},
            "dtype": {"const": "uint8"},
            "range": {"const": [0, 255]},
            "channel_degradation": {"const": "achromatic-equal"},
            "restoration_preprocessing": {"const": "none"},
            "forbidden_transformations": {
              "const": ["grayscale", "background-whitening", "contrast-normalization", "binarization"]
            }
          }
        },
        "alignment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["divisibility_crop", "crop_edges", "border", "rounding"],
          "properties": {
            "divisibility_crop": {"const": "lower-right-remainder"},
            "crop_edges": {"const": ["bottom", "right"]},
            "border": {"const": "reflect-101"},
            "rounding": {"const": "clip-0-255-rint-cast"}
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "library", "reduction_interpolation", "opencv_threads", "opencl",
            "jpeg_colour_order", "jpeg_sampling_factor", "jpeg_progressive", "jpeg_optimize"
          ],
          "properties": {
            "library": {"const": "opencv"},
            "reduction_interpolation": {"const": "INTER_AREA"},
            "opencv_threads": {"const": 1},
            "opencl": {"const": false},
            "jpeg_colour_order": {"const": "RGB-BGR-explicit"},
            "jpeg_sampling_factor": {"const": "4:4:4"},
            "jpeg_progressive": {"const": false},
            "jpeg_optimize": {"const": false}
          }
        },
        "condition_order": {
          "const": ["x2-clean", "x2-moderate", "x2-strong", "x4-clean", "x4-moderate", "x4-strong"]
        },
        "conditions": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {"$ref": "#/$defs/condition"}
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition_id", "scale", "severity", "operations", "reduction", "blur", "noise", "quantization", "jpeg"],
      "properties": {
        "condition_id": {"enum": ["x2-clean", "x2-moderate", "x2-strong", "x4-clean", "x4-moderate", "x4-strong"]},
        "scale": {"enum": [2, 4]},
        "severity": {"enum": ["clean", "moderate", "strong"]},
        "operations": {
          "oneOf": [
            {"const": ["reduction"]},
            {"const": ["blur", "reduction", "noise", "clip-round", "jpeg"]}
          ]
        },
        "reduction": {
          "type": "object", "additionalProperties": false, "required": ["interpolation"],
          "properties": {"interpolation": {"const": "INTER_AREA"}}
        },
        "blur": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["type", "sigma", "kernel"],
              "properties": {
                "type": {"const": "gaussian"},
                "sigma": {"enum": [0.8, 1.2, 1.6, 1.8, 2.4, 3.0, 4.0]},
                "kernel": {"enum": [7, 9, 11, 13, 17, 21, 29]}
              }
            }
          ]
        },
        "noise": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["type", "sigma"],
              "properties": {"type": {"const": "gaussian"}, "sigma": {"enum": [3.0, 5.0, 6.0, 8.0, 14.0]}}
            }
          ]
        },
        "quantization": {"const": "clip-0-255-rint-cast"},
        "jpeg": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object", "additionalProperties": false,
              "required": ["quality", "sampling_factor", "progressive", "optimize"],
              "properties": {
                "quality": {"enum": [20, 30, 40, 60, 75, 85]},
                "sampling_factor": {"const": "4:4:4"},
                "progressive": {"const": false},
                "optimize": {"const": false}
              }
            }
          ]
        }
      }
    }
  }
}
