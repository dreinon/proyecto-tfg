{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:score-super-resolution:schema:v2:manifest-descriptor",
  "title": "Immutable compact SMB manifest generation descriptor v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "manifest_id",
    "generation_id",
    "generation_algorithm",
    "source_key",
    "source_revision",
    "creation_command",
    "source_provenance",
    "grouping_unit",
    "upstream_split",
    "project_split",
    "deterministic_seed",
    "exclusions",
    "row_schema_id",
    "row_schema_version",
    "row_count",
    "records_sha256",
    "audit_version",
    "benchmark_state",
    "hash_provenance",
    "duplicate_provenance",
    "sample_selection",
    "review_inference"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "record_type": {"const": "manifest-descriptor"},
    "manifest_id": {"const": "smb-evaluation-v2"},
    "generation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation_algorithm": {"$ref": "#/$defs/generation_algorithm"},
    "source_key": {"const": "smb"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "creation_command": {"type": "string", "minLength": 1},
    "source_provenance": {"$ref": "#/$defs/source_provenance"},
    "grouping_unit": {"const": "source_score"},
    "upstream_split": {"const": "test"},
    "project_split": {"const": "evaluation"},
    "deterministic_seed": {"type": "integer", "minimum": 0},
    "exclusions": {
      "type": "array",
      "items": {"$ref": "#/$defs/exclusion"}
    },
    "row_schema_id": {"const": "manifest-row"},
    "row_schema_version": {"const": 2},
    "row_count": {"const": 685},
    "records_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audit_version": {"const": "smb-audit-v2"},
    "benchmark_state": {"const": "AUDITED_LOCKED"},
    "hash_provenance": {"$ref": "#/$defs/hash_provenance"},
    "duplicate_provenance": {"$ref": "#/$defs/duplicate_provenance"},
    "sample_selection": {"$ref": "#/$defs/sample_selection"},
    "review_inference": {"$ref": "#/$defs/review_inference"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation_algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version",
        "domain_separator",
        "descriptor_canonicalization",
        "records_canonicalization"
      ],
      "properties": {
        "algorithm": {"const": "sha256"},
        "version": {"const": 2},
        "domain_separator": {"const": "smb-manifest-generation-v2"},
        "descriptor_canonicalization": {"const": "yaml-safe-sort-keys-utf8-v1"},
        "records_canonicalization": {"const": "jsonl-utf8-sorted-keys-v1"}
      }
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_set_version",
        "algorithm",
        "revision",
        "dirty",
        "source_tree_sha256",
        "patch_sha256",
        "lock_sha256"
      ],
      "properties": {
        "source_set_version": {"const": 1},
        "algorithm": {"const": "sha256"},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "dirty": {"type": "boolean"},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "patch_sha256": {"$ref": "#/$defs/sha256"},
        "lock_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_index", "item_id", "reason"],
      "properties": {
        "upstream_index": {"type": "integer", "minimum": 0, "maximum": 684},
        "item_id": {"type": "string", "pattern": "^smb-test-[0-9]{6}$"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "hash_algorithm": {
      "oneOf": [
        {"$ref": "#/$defs/legacy_hash_algorithm"},
        {"$ref": "#/$defs/canonical_pixel_hash_algorithm"}
      ]
    },
    "legacy_hash_algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "version", "canonicalization"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "version": {"const": 1},
        "canonicalization": {"enum": ["encoded-bytes-v1", "rgba-uint8-row-major-v1"]}
      }
    },
    "canonical_pixel_hash_algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version",
        "canonicalization",
        "domain_separator",
        "decoder_library",
        "decoder_version",
        "output_mode",
        "alpha_policy",
        "orientation_policy",
        "metadata_policy",
        "max_encoded_bytes",
        "max_pixels",
        "failure_policy"
      ],
      "properties": {
        "algorithm": {"const": "sha256"},
        "version": {"const": 2},
        "canonicalization": {"const": "canonical-rgba-frame-v2"},
        "domain_separator": {"const": "smb-canonical-rgba-frame-v2"},
        "decoder_library": {"const": "Pillow"},
        "decoder_version": {"const": "12.3.0"},
        "output_mode": {"const": "RGBA8"},
        "alpha_policy": {"const": "retain-alpha-and-underlying-rgb"},
        "orientation_policy": {"const": "stored-raster-ignore-exif"},
        "metadata_policy": {"const": "ignore-non-raster-metadata"},
        "max_encoded_bytes": {"const": 67108864},
        "max_pixels": {"const": 100000000},
        "failure_policy": {"const": "safe-explicit-failure-no-digest"}
      }
    },
    "hash_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoded", "pixels"],
      "properties": {
        "encoded": {"$ref": "#/$defs/hash_algorithm"},
        "pixels": {"$ref": "#/$defs/hash_algorithm"}
      }
    },
    "exact_duplicate_algorithm": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "version"],
          "properties": {
            "algorithm": {"const": "encoded-and-pixel-sha256"},
            "version": {"const": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "version"],
          "properties": {
            "algorithm": {"const": "canonical-pixel-sha256"},
            "version": {"const": 2}
          }
        }
      ]
    },
    "near_duplicate_algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version",
        "library",
        "library_version",
        "hash_size",
        "highfreq_factor",
        "maximum_hamming_distance"
      ],
      "properties": {
        "algorithm": {"const": "phash"},
        "version": {"const": 1},
        "library": {"const": "ImageHash"},
        "library_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "hash_size": {"type": "integer", "minimum": 4},
        "highfreq_factor": {"type": "integer", "minimum": 1},
        "maximum_hamming_distance": {"type": "integer", "minimum": 0}
      }
    },
    "duplicate_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exact", "near"],
      "properties": {
        "exact": {"$ref": "#/$defs/exact_duplicate_algorithm"},
        "near": {"$ref": "#/$defs/near_duplicate_algorithm"}
      }
    },
    "sample_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version",
        "seed",
        "population_size",
        "sample_size",
        "identity_fields",
        "selection_state"
      ],
      "properties": {
        "algorithm": {"const": "sha256-rank"},
        "version": {"const": 1},
        "seed": {"type": "integer", "minimum": 0},
        "population_size": {"const": 685},
        "sample_size": {"const": 64},
        "identity_fields": {
          "type": "array",
          "prefixItems": [{"const": "upstream_index"}, {"const": "item_id"}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "selection_state": {"const": "pre-review"}
      }
    },
    "review_inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "automated_population_audit_count",
        "sampled_human_review_count",
        "targeted_human_review_count",
        "not_visually_reviewed_count",
        "unavailable_visual_review_count",
        "not_applicable_visual_review_count",
        "exact_pair_automated_count",
        "perceptual_pair_count",
        "perceptual_pair_human_review_count",
        "perceptual_pair_pending_count",
        "inference_scope",
        "population_prevalence_inference"
      ],
      "properties": {
        "automated_population_audit_count": {"const": 685},
        "sampled_human_review_count": {"const": 64},
        "targeted_human_review_count": {"type": "integer", "minimum": 0, "maximum": 621},
        "not_visually_reviewed_count": {"type": "integer", "minimum": 0, "maximum": 621},
        "unavailable_visual_review_count": {"type": "integer", "minimum": 0, "maximum": 621},
        "not_applicable_visual_review_count": {"type": "integer", "minimum": 0, "maximum": 621},
        "exact_pair_automated_count": {"type": "integer", "minimum": 0},
        "perceptual_pair_count": {"type": "integer", "minimum": 0},
        "perceptual_pair_human_review_count": {"type": "integer", "minimum": 0},
        "perceptual_pair_pending_count": {"type": "integer", "minimum": 0},
        "inference_scope": {"const": "sample_observation_only"},
        "population_prevalence_inference": {"const": "not_supported"}
      },
      "allOf": [
        {
          "if": {"properties": {"targeted_human_review_count": {"const": 0}}},
          "then": {
            "properties": {
              "not_visually_reviewed_count": {"const": 621},
              "unavailable_visual_review_count": {"const": 0},
              "not_applicable_visual_review_count": {"const": 0}
            }
          }
        }
      ]
    }
  }
}
