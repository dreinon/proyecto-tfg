{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:score-super-resolution:schema:v2:notation-review",
  "title": "Structured human notation review v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "review_id", "sample_membership_id", "sample_sha256",
    "panel_id", "reviewer", "reviewed_at", "labels", "severity", "rationale"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "record_type": {"const": "notation-review"},
    "review_id": {"$ref": "#/$defs/stable_id"},
    "sample_membership_id": {"$ref": "#/$defs/stable_id"},
    "sample_sha256": {"$ref": "#/$defs/sha256"},
    "panel_id": {"$ref": "#/$defs/stable_id"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 200},
    "reviewed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "labels": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": [
        "staff-line-removal", "staff-line-breakage", "staff-line-thickening",
        "staff-line-hallucination", "altered-symbol", "unintended-join",
        "unintended-separation", "text-or-digit-corruption", "plausible-musical-change",
        "none-observed"
      ]}
    },
    "severity": {"type": ["string", "null"], "enum": ["minor", "material", "unusable", null]},
    "rationale": {"type": "string", "maxLength": 2000}
  },
  "oneOf": [
    {
      "properties": {
        "labels": {"const": ["none-observed"]}, "severity": {"const": null}
      }
    },
    {
      "properties": {
        "labels": {"not": {"contains": {"const": "none-observed"}}},
        "severity": {"enum": ["minor", "material", "unusable"]},
        "rationale": {"minLength": 1}
      }
    }
  ],
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
