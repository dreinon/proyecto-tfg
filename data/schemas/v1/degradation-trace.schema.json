{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:score-super-resolution:schema:v1:degradation-trace",
  "title": "Per-item degradation trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "trace_id",
    "experiment_id",
    "execution_id",
    "item_id",
    "degradation_config_id",
    "seed",
    "input_sha256",
    "output_sha256",
    "operations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "degradation-trace"},
    "trace_id": {"$ref": "#/$defs/stable_id"},
    "experiment_id": {"$ref": "#/$defs/stable_id"},
    "execution_id": {"$ref": "#/$defs/stable_id"},
    "item_id": {"$ref": "#/$defs/stable_id"},
    "degradation_config_id": {"$ref": "#/$defs/stable_id"},
    "seed": {"type": "integer", "minimum": 0},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "operator_id", "parameters"],
        "properties": {
          "order": {"type": "integer", "minimum": 1},
          "operator_id": {"$ref": "#/$defs/stable_id"},
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": {"$ref": "#/$defs/stable_id"},
                "value": {"type": ["string", "number", "integer", "boolean"]},
                "unit": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
