{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:score-super-resolution:schema:v1:method-output",
  "title": "Per-item method output identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "output_id",
    "experiment_id",
    "execution_id",
    "item_id",
    "method_id",
    "input_sha256",
    "output_sha256",
    "output_path",
    "dimensions",
    "color_mode",
    "produced_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "method-output"},
    "output_id": {"$ref": "#/$defs/stable_id"},
    "experiment_id": {"$ref": "#/$defs/stable_id"},
    "execution_id": {"$ref": "#/$defs/stable_id"},
    "item_id": {"$ref": "#/$defs/stable_id"},
    "method_id": {"$ref": "#/$defs/stable_id"},
    "input_sha256": {"$ref": "#/$defs/sha256"},
    "output_sha256": {"$ref": "#/$defs/sha256"},
    "output_path": {"$ref": "#/$defs/relative_path"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "color_mode": {"type": "string", "minLength": 1},
    "produced_at": {"$ref": "#/$defs/utc_timestamp"}
  },
  "$defs": {
    "stable_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "utc_timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    }
  }
}
