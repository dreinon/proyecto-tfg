{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:score-super-resolution:schema:v1:staff-scale-degradation-trace",
  "title": "Effective page-specific staff-scale degradation trace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "record_type", "control_id", "control_sha256", "item_id",
    "source_group_id", "condition_id", "scale", "staff_spacing_px", "derived_seed",
    "input_pixel_sha256", "aligned_pixel_sha256", "output_pixel_sha256", "operations",
    "trace_id"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "record_type": {"const": "staff-scale-degradation-trace"},
    "control_id": {"const": "staff-scale-score-v2"},
    "control_sha256": {"$ref": "#/$defs/sha256"},
    "item_id": {"type": "string", "pattern": "^smb-test-[0-9]{6}$"},
    "source_group_id": {"type": "string", "minLength": 1},
    "condition_id": {"enum": ["x2-clean", "x2-moderate", "x2-strong", "x4-clean", "x4-moderate", "x4-strong"]},
    "scale": {"enum": [2, 4]},
    "staff_spacing_px": {"type": "number", "minimum": 4, "maximum": 32},
    "derived_seed": {"type": "integer", "minimum": 0},
    "input_pixel_sha256": {"$ref": "#/$defs/sha256"},
    "aligned_pixel_sha256": {"$ref": "#/$defs/sha256"},
    "output_pixel_sha256": {"$ref": "#/$defs/sha256"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "object"}},
    "trace_id": {"type": "string", "pattern": "^staff-scale-degradation-[0-9a-f]{64}$"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
